    "transition_hint_title": {
        "font_size": 32,
        "text": {
            "ja": "ゲームのヒント",
            "en": "Hints",
            "zh": "遊戲提示",
            "ko": "게임의 힌트"
        }
    },
    "transition_hint_line1": {
        "font_size": 26,
        "text": {
            "ja": "太鼓の面とフチをたたいてリズムにのろう!",
            "en": "Hit the drum face and rim and ride the rhythm!",
            "zh": "敲擊鼓面和鼓邊，跟上節奏吧！",
            "ko": "북면과 테두리를 두드려 리듬을 타자!"
        }
    },
    "transition_hint_line2": {
        "font_size": 26,
        "text": {
            "ja": "黄色い連打音符はたたいた数だけ得点アップ!",
            "en": "Yellow drumroll notes: every hit adds to your score!",
            "zh": "黃色連打音符敲得越多得分越高！",
            "ko": "노란 연타 음표는 두드린 만큼 점수 UP!"
        }
    },
    "tutorial_skip": {
        "font_size": 48,
        "text": {
            "ja": "フチを5回叩くと説明がおわるよ",
            "en": "Hit the rim 5 times to skip",
            "zh": "敲擊5次鼓邊即可結束說明",
            "ko": "테두리를 5번 치면 설명이 끝나"
        }
    },
    "tutorial_clear": {
        "font_size": 44,
        "text": {
            "ja": "ココをこえれば\nクリア",
            "en": "Get past here\nto clear",
            "zh": "超過這個位置\n就算通關了！",
            "ko": "여기를 넘으면\n클리어"
        }
    },
    "tutorial_caption_1": {
        "font_size": 38,
        "text": {
            "ja": "このゲームのあそびかたをおしえるよ",
            "en": "This is how to play!",
            "zh": "現在開始講解遊戲的玩法",
            "ko": "이 게임의 플레이 방법을 알려줄게"
        }
    },
    "tutorial_caption_2": {
        "font_size": 38,
        "text": {
            "ja": "流れてくる音符が\nワクにかさなったら\nバチで太鼓をたたこう",
            "en": "When a note flows in\nand reaches the frame,\nhit the drum with your sticks!",
            "zh": "注意畫面\n當音符移動至與敲擊框重合\n便敲擊太鼓吧！",
            "ko": "흘러오는 음표가\n틀에 겹쳐지면\n북채로 북을 치자"
        }
    },
    "tutorial_caption_3": {
        "font_size": 38,
        "text": {
            "ja": "太鼓のどうの部分は\nキケンだからたたかないでね",
            "en": "Don't hit the side of the drum,\nit's dangerous!",
            "zh": "為避免危險\n請不要敲擊鼓身",
            "ko": "북의 몸통 부분은\n위험하니까 치지 마"
        }
    },
    "tutorial_caption_4": {
        "font_size": 38,
        "text": {
            "ja": "赤い音符{don}は面をたたこう",
            "en": "Red notes {don} : hit the face!",
            "zh": "{don} 敲打鼓面吧",
            "ko": "빨간 음표{don}는 면을 치자"
        }
    },
    "tutorial_caption_5": {
        "font_size": 38,
        "text": {
            "ja": "青い音符{kat}はフチをたたこう",
            "en": "Blue notes {kat} : hit the rim!",
            "zh": "{kat} 敲打鼓邊吧",
            "ko": "파란 음표{kat}는 테를 치자"
        }
    },
    "tutorial_caption_6": {
        "font_size": 38,
        "text": {
            "ja": "大きな音符{big_don}{big_kat}は\n強くたたくと高得点！",
            "en": "Big notes {big_don}{big_kat}\nscore more when hit hard!",
            "zh": "{big_don}{big_kat} 用雙手用力敲打！",
            "ko": "큰 음표{big_don}{big_kat}는\n세게 치면 고득점!"
        }
    },
    "tutorial_caption_7": {
        "font_size": 38,
        "text": {
            "ja": "黄色い音符{roll}は\nひたすら連打！",
            "en": "Yellow notes {roll}\nhit them as fast as you can!",
            "zh": "{roll} 不停連續敲打！",
            "ko": "노란 음표{roll}는\n계속 연타!"
        }
    },
    "tutorial_caption_8": {
        "font_size": 38,
        "text": {
            "ja": "ふうせん音符{balloon}と\nくすだま音符{kusudama}もとにかく連打ー！",
            "en": "Balloon notes {balloon} and\nkusudama notes {kusudama}: keep drumming!",
            "zh": "{balloon}{kusudama} 總之連續敲打吧！",
            "ko": "풍선 음표{balloon}와\n쿠스다마 음표{kusudama}도 무조건 연타!"
        }
    },
    "tutorial_caption_9": {
        "font_size": 38,
        "text": {
            "ja": "タイミングよくたたけば\n魂（たましい）ゲージがアップ！",
            "en": "Hit with good timing\nto fill the soul gauge!",
            "zh": "時機把握得好，\n就能積累魂槽哦！",
            "ko": "타이밍 좋게 치면\n혼 게이지가 올라가!"
        }
    },
    "tutorial_caption_10": {
        "font_size": 38,
        "text": {
            "ja": "うまくたたいてクリアをめざそう！",
            "en": "Play well and aim for a clear!",
            "zh": "盡情擊打，爭取過關吧！",
            "ko": "잘 쳐서 클리어를 노리자!"
        }
    },
