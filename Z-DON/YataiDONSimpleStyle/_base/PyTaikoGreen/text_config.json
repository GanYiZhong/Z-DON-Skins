  "entry_game_desc": {
    "text": {
      "en": "Pick any song and\ndifficulty to play!",
      "ja": "好きな曲やむずかしさを\nえらんであそべるよ！",
      "zh": "選擇喜歡的歌曲\n和難度來遊玩！",
      "ko": "좋아하는 곡과 난이도를\n골라 플레이해요!"
    }
  },
  "entry_dan_desc": {
    "text": {
      "en": "Take on dan courses and\nearn your rank!",
      "ja": "段位道場に挑戦して\n段位をめざそう！",
      "zh": "挑戰段位道場，\n爭取更高段位！",
      "ko": "단위도장에 도전해\n단위를 올려요!"
    }
  },
  "entry_ai_battle_desc": {
    "text": {
      "en": "Win or lose against AI Don!\nEnjoy a down-to-the-wire battle!\nYour scores and crowns are saved too!",
      "ja": "AIどんどん勝つか負けるか\nギリギリのバトルを楽しもう！\nスコアや王冠の成績も記録されるよ",
      "zh": "與AI小咚一決勝負，\n享受驚險刺激的對戰！\n分數和王冠成績也會被記錄哦！",
      "ko": "AI 동이와 이기느냐 지느냐,\n아슬아슬한 배틀을 즐겨요!\n점수와 왕관 기록도 저장돼요!"
    }
  },
  "entry_enso_battle_desc": {
    "text": {
      "en": "Hit notes to damage monsters!\nFill the gauge to unleash\na special move!",
      "ja": "音符をたたいてモンスターに\nダメージをあたえよう！\nゲージがたまると必殺技！",
      "zh": "敲击音符对怪物造成伤害！\n槽满后释放必杀技！",
      "ko": "음표를 쳐서 몬스터에게\n대미지를 줘요!\n게이지가 차면 필살기!"
    }
  },
  "entry_waiwai_desc": {
    "text": {
      "en": "Two players play together\nand match their breath!",
      "ja": "2人で息を合わせて\nいっしょに演奏しよう！",
      "zh": "两人一起配合\n默契演奏！",
      "ko": "둘이서 호흡을 맞춰\n함께 연주해요!"
    }
  },
  "entry_practice_desc": {
    "text": {
      "en": "Practice with fast-forward,\nrewind and tempo changes!",
      "ja": "早送り、早戻し、曲テンポ変更\nなど専用の機能をつかった\n特訓ができるよ！",
      "zh": "使用快進、倒帶、變速等\n專用功能進行特訓！",
      "ko": "빨리감기, 되감기, 속도 변경\n등으로 연습해요!"
    }
  },
  "entry_costume_desc": {
    "text": {
      "en": "Change your Don's\ncostume!",
      "ja": "ドンちゃんの\nきせかえができるよ！",
      "zh": "更換小咚的服裝！",
      "ko": "동이의 의상을\n갈아입혀요!"
    }
  },
  "entry_settings_desc": {
    "text": {
      "en": "Change game and\ndisplay settings!",
      "ja": "あそびかたや画面の\nせっていをかえるよ！",
      "zh": "更改遊戲和顯示設定！",
      "ko": "게임과 화면 설정을\n바꿔요!"
    }
  },
  "entry_access_code_desc": {
    "text": {
      "en": "Show your access code\nand login QR code!",
      "ja": "アクセスコードと\nログイン用QRコードを\nひょうじするよ！",
      "zh": "显示访问码和登录二维码！",
      "ko": "액세스 코드와\n로그인 QR 코드를 봐요!"
    }
  },
